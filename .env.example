# Copy to .env (gitignored) and fill in. docker compose reads it automatically.
# Machine running ComfyUI (:8188), vLLM (:8000) and Fish Speech (:7860):
# the Docker host's LAN IP, or host.docker.internal when they run on the Docker host.
GPU_HOST=host.docker.internal
# vLLM served model name
VLLM_MODEL=agents-a1
