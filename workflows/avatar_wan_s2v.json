{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_s2v_14B_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Wan 2.2 S2V" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" },
    "_meta": { "title": "umt5 text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" }
  },
  "4": {
    "class_type": "AudioEncoderLoader",
    "inputs": { "audio_encoder_name": "wav2vec2_large_english_fp16.safetensors" }
  },
  "5": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "videogen_avatar_spike.wav" },
    "_meta": { "title": "the voiceover to lip-sync to" }
  },
  "6": {
    "class_type": "AudioEncoderEncode",
    "inputs": { "audio_encoder": ["4", 0], "audio": ["5", 0] }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": { "image": "videogen_avatar_spike.png" },
    "_meta": { "title": "the channel avatar" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "A man speaking directly to the camera, talking naturally.", "clip": ["2", 0] }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "clip": ["2", 0] },
    "_meta": { "title": "Wan's own trained negative" }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8 }
  },
  "11": {
    "class_type": "WanSoundImageToVideo",
    "inputs": {
      "positive": ["8", 0], "negative": ["9", 0], "vae": ["3", 0],
      "width": 640, "height": 640, "length": 77, "batch_size": 1,
      "audio_encoder_output": ["6", 0], "ref_image": ["7", 0]
    }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0], "seed": 20, "steps": 20, "cfg": 6,
      "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1,
      "positive": ["11", 0], "negative": ["11", 1], "latent_image": ["11", 2]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["12", 0], "vae": ["3", 0] }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["13", 0], "fps": 16, "audio": ["5", 0] }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["14", 0], "filename_prefix": "video/videogen_avatar_wan", "format": "auto", "codec": "auto" }
  }
}
